{
  "name": "mqtt-publisher-lite",
  "version": "1.0.0",
  "description": "Lightweight MQTT Publisher for firmware testing - no external dependencies",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run test:unit && npm run test:connections",
    "test:unit": "jest --passWithNoTests",
    "test:connections": "ts-node --transpile-only tests/integration/connections.ts",
    "test:manual:ig-lua": "ts-node --transpile-only tests/manual/instagram-lua-scripts.ts",
    "test:mqtt-mtls": "ts-node --transpile-only scripts/test-mqtt-mtls.ts",
    "smoke:attention": "ts-node --transpile-only scripts/attention-roadmap-smoke.ts",
    "pki": "ts-node --transpile-only scripts/pki/pki.ts",
    "pki:broker": "./scripts/pki/generate-broker-cert.sh",
    "pki:print-broker": "./scripts/pki/print-railway-broker-env.sh",
    "pki:verify": "./scripts/pki/verify-broker-tls.sh --compare-both",
    "mongo:ping": "ts-node --transpile-only scripts/mongo-ping.ts",
    "db:migrate:cert-slots": "ts-node --transpile-only scripts/migrate-device-certificates-to-slots.ts",
    "clean": "rm -rf dist data/*.json"
  },
  "keywords": [
    "mqtt",
    "firmware",
    "testing",
    "lightweight"
  ],
  "author": "StatsMQTT Team",
  "license": "MIT",
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "@proof-socials/socials": "^1.1.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/compression": "^1.7.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/uuid": "^8.3.4",
    "@types/ws": "^8.5.0",
    "better-sqlite3": "^11.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.4.1",
    "google-auth-library": "^9.14.0",
    "googleapis": "^144.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "mqtt": "^5.3.0",
    "node-forge": "^1.3.1",
    "redis": "^4.6.0",
    "typescript": "^5.1.0",
    "uuid": "^8.3.2",
    "winston": "^3.10.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": "18.x",
    "npm": ">=8.0.0"
  }
}
