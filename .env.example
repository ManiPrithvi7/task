LOG_LEVEL=info
SESSION_SECRET=change-me-in-production
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-in-production

# Admin authentication for admin routes
# ADMIN_EMAIL_DOMAINS=withproof.io
# ADMIN_USER_IDS=
# INTERNAL_HEALTH_SECRET=change-me-in-production
# CORS_ALLOWED_ORIGINS=https://app.withproof.io,https://dashboard.withproof.io

# Pilot mode for OTA testing
PILOT_MODE=false
PILOT_OTA_DOWNLOAD_BASE_URL=
PILOT_OTA_RATE_LIMIT_PER_MIN=10

# InfluxDB (required — server will not start without these)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-token
INFLUXDB_ORG=statsmqtt
INFLUXDB_BUCKET=metrics
INFLUXDB_COMPLIANCE_BUCKET=pki_compliance

# Writable runtime paths (Docker image sets these; local defaults to ./data)
# DATA_DIR=./data
# PROVISIONING_CA_DIR=./data/certs
# CA_STORAGE_PATH=./data/certs

# Write tuning (durability + HTTP efficiency — no memory buffer)
# INFLUXDB_DISK_QUEUE=true
# INFLUXDB_DISK_QUEUE_SYNC=false
# INFLUXDB_QUEUE_FLUSH_MS=1000
# Recommended production values (see Influx optimization plan):
# INFLUX_AUDIT_MAX_FIELD_LENGTH=512
# INFLUXDB_QUEUE_BATCH_MAX=500
# INFLUXDB_CLIENT_BATCH_SIZE=500
# INFLUXDB_CLIENT_FLUSH_INTERVAL_MS=5000
# INFLUX_AUDIT_MAX_FIELD_LENGTH=4096
# INFLUXDB_RETENTION_DAYS=30

# Google Business Profile (GMB connect sync + webhooks)
# GOOGLE_BUSINESS_CLIENT_ID=
# GOOGLE_BUSINESS_CLIENT_SECRET=

# TEMP STIMULATE — remove after testing (runs in-process when set; no separate command)
# STIMULATE_DEVICE="DEVICE-12,DEVICE-13"
# STIMULATE_PLATFORMS="instagram,gmb"
# STIMULATE_INTERVAL_MS=30000
# STIMULATE_STEP=1
# STIMULATE_IG_TARGET=500
# STIMULATE_GMB_TARGET=100
# In-memory ramps; /active on allowlisted device resets from 0. Optional: clear Redis stim locks on boot.
# STIMULATE_CLEAR=1
