# Example environment configuration
#
# MongoDB Atlas / self-hosted (required for app startup)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/dbname?retryWrites=true&w=majority
# MONGODB_DB_NAME=statsnapp
#
# Optional — defaults tuned for Atlas (DNS + TLS); raise if "Server selection timed out":
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
# MONGODB_CONNECT_TIMEOUT_MS=20000
#
# MQTT reconnect (0 = infinite retries; custom cap bypassed when 0)
# MQTT_RECONNECT_PERIOD=2000
# MQTT_MAX_RECONNECT_ATTEMPTS=0
#
# Optional DNS preflight before connect (default off — enable only if EAI_AGAIN is frequent)
# MQTT_DNS_PREFLIGHT_ENABLED=false
#
# Railway TCP proxy / custom domain:
# - Attach broker.withproof.io to the NanoMQ MQTT TCP service (not the HTTP app).
# - DNS: CNAME broker.withproof.io → Railway TCP service target (grey cloud if using Cloudflare).
# - MQTT_BROKER=broker.withproof.io (or switchback.proxy.rlwy.net during migration)
# - MQTT_TLS_SERVERNAME=nanomq-broker   # Option A (safest cutover; cert SAN includes nanomq-broker)
# - After 30d stable: MQTT_TLS_SERVERNAME=broker.withproof.io  # Option B
#
# PKI (see scripts/pki/README.md):
#   npm run pki -- init-ca              # Root CA → data/ca/
#   npm run pki -- app-client           # Proof app client → data/mqtt-client/ + base64 env
#   npm run pki -- rotate               # destructive Root CA rotation
#   npm run pki:broker                  # broker leaf cert (OpenSSL)
#   npm run pki:print-broker            # NANOMQ_TLS_*_BASE64 for Railway NanoMQ
#   npm run pki:verify                  # TLS check both broker hostnames
# Remove switchback.proxy.rlwy.net from broker SAN at next renewal after migration.
#
# Validate without starting the server (Mongo wire protocol — not curl):
#   npm run mongo:ping
#
# InfluxDB 2.x — implicit enable: set INFLUXDB_TOKEN (and optionally INFLUXDB_URL).
# Omit INFLUXDB_TOKEN entirely to skip Influx locally.
#
# Default (recommended): disk write-ahead queue under DATA_DIR — startup continues if HTTP health fails;
# points append locally and a background worker batches POSTs (stateless HTTP, no long-lived socket).
# Render: attach a persistent disk on DATA_DIR if you must survive redeploys without losing queued lines.
#
# INFLUXDB_DISK_QUEUE=false   # strict mode: fail startup when /health + buckets API fail (legacy)
# INFLUXDB_DISK_QUEUE_PATH=./data/influx-write-queue.lines   # optional absolute or cwd-relative path
# INFLUXDB_QUEUE_FLUSH_MS=5000
# INFLUXDB_QUEUE_BATCH_MAX=500
# INFLUXDB_QUEUE_MAX_LINES_PER_FILE=100000
#
# Hosted on Render: HTTPS origin only (no :8086 / :10000 in URL — proxy forwards to the container).
# Match DOCKER_INFLUXDB_INIT_* on the Influx service for org/bucket; token must match API access.
#
# INFLUXDB_URL=https://influxdb-rc96.onrender.com
# (alias) INFLUXDB_HOST=https://influxdb-rc96.onrender.com  # used if INFLUXDB_URL is unset
# INFLUXDB_TOKEN=<Influx API token / admin token from setup>
# INFLUXDB_ORG=statsmqtt
# INFLUXDB_BUCKET=metrics
#
# Optional: startup REST probe timeout (GET /api/v2/buckets). Falls back to INFLUXDB_FLUX_PROBE_TIMEOUT_MS if unset.
# INFLUXDB_API_PROBE_TIMEOUT_MS=20000
#
# Idle / cold start (e.g. Render): retry /health and buckets (default 3 attempts, 2.5s apart; loopback uses 1 attempt).
# INFLUXDB_HEALTH_RETRIES=3
# INFLUXDB_HEALTH_RETRY_DELAY_MS=3000
# INFLUXDB_HEALTH_TIMEOUT_MS=25000
#
# Local default when both INFLUXDB_URL and INFLUXDB_HOST are omitted: http://localhost:8086
#
# PKI governance (audit + enforce on production_v1)
# PKI_AUDIT_LOG_ENABLED=true
# TRANSPARENCY_LOG_ENABLED=true
#
# Enforcement (defaults ON — legacy certs without KU/EKU will fail registration)
# Set ENFORCE_RUNTIME_KU_EKU=false until all devices re-provisioned, then re-enable.
# ENFORCE_RUNTIME_KU_EKU=true
# CHAIN_VALIDATION_ENABLED=true          # enable after root CA is on all devices
# INTERMEDIATE_CA_ENABLED=false
#
# CSR rate limits (defaults: 10/3/5 per 15 min window; global 100/min)
# CSR_RATE_LIMIT_PROVISIONED=10
# CSR_RATE_LIMIT_UNPROVISIONED=3
# CSR_RATE_LIMIT_PER_IP=5
# CSR_RATE_LIMIT_GLOBAL=100
# CSR_RATE_LIMIT_WINDOW=900
#
# Rollback: ENFORCE_RUNTIME_KU_EKU=false CHAIN_VALIDATION_ENABLED=false redeploy
# Monitor Influx pki_audit for KU_EKU_VALIDATION_FAILED / CHAIN_VALIDATION_FAILED spikes
#
# Redis (Upstash)
# - Optional in development: if unset, provisioning tokens fall back to in-memory storage.
# - Required in production: app will refuse to start without it.
#
# IMPORTANT: Must use TLS.
REDIS_URL=rediss://default:your_password@your-upstash-instance.upstash.io:6379
#
# Instagram — poller runs when REDIS_URL is connected. Graph fetches default to THIS SERVER unless you offload:
#
# Optional serverless (burst / scale-out): when set, ALL poller fetches POST to this URL.
# If unset, the app calls Instagram Graph API directly. Credentials: Redis proof.mqtt:device:{id}
# and active-devices.json are filled at /active registration from Mongo (Device.userId → Social).
# Aliases: VERCEL_INSTAGRAM_FETCH_URL, VERCEL_INSTAGRAM_FETCH_API_KEY
#
# INSTAGRAM_SERVERLESS_URL=http://localhost:3000/api/instagram/fetch
# INSTAGRAM_SERVERLESS_API_KEY=
# INSTAGRAM_SERVERLESS_TIMEOUT_MS=30000
#
# Serverless POST body: deviceIds, trigger, optional correlation_id (worker loads creds from Redis).
#
# Screen publisher (stats cycle): mock Instagram is OFF by default so `/instagram` is not overwritten
# with fake numbers. Set only for firmware demos without Graph polling:
# STATS_PUBLISHER_MOCK_INSTAGRAM=true
#
# Webhook ingress — statsmqtt src/lib/socials (+ @proof-socials/socials for GMB/Shopify/Square primitives)
#
# WEBHOOK_PUBLIC_BASE_URL — primary public root (no trailing slash).
#   Square HMAC URL: WEBHOOK_PUBLIC_BASE_URL + /api/pos-promotions/webhooks/square
#   GMB Pub/Sub audience: WEBHOOK_PUBLIC_BASE_URL + /api/webhooks/google-business-reviews
#   Fallbacks: NEXT_PUBLIC_MQTT_PUBLIC_URL, NEXT_PUBLIC_APP_URL, PUBLIC_APP_URL (deprecated alias).
#
# WEBHOOK_ENABLED=true
# WEBHOOK_PUBLIC_BASE_URL=https://server.withproof.io
# PUBLIC_APP_URL=   # deprecated — use WEBHOOK_PUBLIC_BASE_URL
# WEBHOOK_MQTT_PUBLISH_ENABLED=true
# WEBHOOK_GMB_FAST_PATH_ONLY=false
# WEBHOOK_DEVICE_TARGET=primary
# SHOPIFY_CLIENT_SECRET=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
#
# GMB_PUBSUB_AUDIENCE — optional override. Set ONLY when WEBHOOK_PUBLIC_BASE_URL is absent.
#   When WEBHOOK_PUBLIC_BASE_URL is set, the audience is derived automatically; do NOT set this.
#   Must match exactly the audience used when the Pub/Sub push subscription was created:
#   https://<your-host>/api/webhooks/google-business-reviews  (no trailing slash)
# GMB_PUBSUB_AUDIENCE=
# GMB_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# GMB_PUBSUB_SKIP_AUTH_VERIFY=true
# GOOGLE_BUSINESS_CLIENT_ID=
# GOOGLE_BUSINESS_CLIENT_SECRET=
# ENABLE_DAILY_METRICS=true
